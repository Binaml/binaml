        "learning_rate": 0.005,
        "l2": 0.0001,
        "center_binary_features": false,
        "batch_size": 1,
        "sgd_steps": 1
      }
    },
    {
      "name": "MLPRegressor",
      "factory": "binaml.models:MLPRegressor",
      "parameters": {
        "hidden_layer_sizes": [100],
        "learning_rate": 0.005,
        "alpha": 0.0001,
